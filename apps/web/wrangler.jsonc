{
  "name": "music-stats-web",
  "main": "src/index.tsx",
  "compatibility_date": "2026-11-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [{ "pattern": "music.rising.sh", "custom_domain": true }],
  "triggers": { "crons": ["* * * * *"] },
  "assets": { "directory": "./public" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "music-stats",
      "database_id": "1c5179e3-3b60-4dfe-89d2-271170894ef0",
      "migrations_dir": "migrations",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "0d3598a079d34bab8e6422847cb34fd9",
    },
  ],
}

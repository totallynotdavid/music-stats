{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "types": [
      "@cloudflare/workers-types",
      "@cloudflare/vitest-plugin/types",
      "vitest/globals"
    ],
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src", "test", "bench", "vitest.config.ts"]
}
